[Unit]
Description=Long Live 24H YouTube LIVE worker (DIRECT COPY)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=longlive
Group=longlive
ExecStart=/usr/bin/python3 /opt/long-live/worker/long_live_worker.py --run
# Python worker 자체 crash만 systemd가 재시작한다. FFmpeg/YouTube 재접속은 worker watchdog 담당.
Restart=on-failure
RestartSec=5
# 설정 오류(영상/키 없음)는 재시작을 반복하지 않는다.
RestartPreventExitStatus=3
# SIGTERM은 worker에만 → worker가 FFmpeg에 q를 보내 정상 종료. 시간 초과 시 전체 SIGKILL.
KillMode=mixed
TimeoutStopSec=20
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/long-live/state /opt/long-live/logs

[Install]
WantedBy=multi-user.target
