[Unit]
Description=Long Live YouTube LIVE worker - channel %i (DIRECT COPY)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=longlive
Group=longlive
# 채널마다 독립 프로세스: 한 채널 worker가 죽어도 다른 채널 송출은 그대로 (systemd가 이 채널만 재시작)
ExecStart=/usr/bin/python3 /opt/long-live/worker/long_live_worker.py --run --profile %i
# Python worker 자체 crash만 systemd가 재시작한다. FFmpeg/YouTube 재접속은 worker watchdog 담당.
Restart=on-failure
RestartSec=5
# 설정 오류(영상/키 없음, 동시 송출 2개 초과, 서버 자원 부족)는 재시작을 반복하지 않는다.
RestartPreventExitStatus=3
# SIGTERM은 worker에만 → worker가 FFmpeg에 q를 보내 정상 종료. 시간 초과 시 전체 SIGKILL.
KillMode=mixed
TimeoutStopSec=20
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/long-live/state /opt/long-live/logs

[Install]
WantedBy=multi-user.target
