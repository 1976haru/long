[Unit]
Description=Long Live scheduled YouTube LIVE (예약 시각에 Cloud 자동 송출)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=longlive
Group=longlive
ExecStart=/usr/bin/python3 /opt/long-live/worker/long_live_worker.py --scheduler
# PC가 꺼져 있어도 예약 job을 확인해야 하므로 항상 다시 켠다. (두 번째 scheduler는 exit 3 → 재시작 안 함)
Restart=always
RestartSec=10
RestartPreventExitStatus=3
# SIGTERM은 scheduler에만 → 송출 중이면 FFmpeg에 q를 보내 정상 종료. 시간 초과 시 전체 SIGKILL.
KillMode=mixed
TimeoutStopSec=30
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/long-live/state /opt/long-live/logs

[Install]
WantedBy=multi-user.target
